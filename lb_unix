def sensor(filename):

    if "op_" in filename.lower():
        pattern = re.compile(r'(?:[^_]*_){2}([^_]*)')
    else:
        pattern = re.compile(r'(?:[^_]*_){1}([^_]*)')

    match = pattern.search(filename)

    if match:
        return match.group(1).strip()

    return ''

def obtener_so(texto):
    texto=str(texto).upper()
    match = re.search(r'.*?(RED HAT).+(\d+\.\d+).+', texto)
    if match:
        return f'{match.group(1)} {match.group(2)}'
    match = re.search(r'.*?(AIX 7)(\.\d+).+', texto)
    if match:
        return f'{match.group(1)}{match.group(2)}'
    match = re.search(r'.*?(SOLARIS).+?([0-9]+).+',texto)
    if match:
        return f'{match.group(1)} {match.group(2)}'
    match = re.search(r'.*?(UBUNTU).+?([0-9]+\.[0-9]+)',texto)
    if match:
        return f'{match.group(1)} {match.group(2)}'
    
