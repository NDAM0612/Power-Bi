def obtener_justificacion(output):
    if isinstance(output, str):
        if 'failed to authenticate using the supplied password' in output.lower():
            return 'Credenciales inválidas'
        elif 'is considered as dead' in output.lower():
            return 'Considerado muerto'
        elif 'open_connection failed: no remote version received' in output.lower():
            return 'Bloqueo de firewall'
        elif 'your password has expired' in output.lower()\
        or 'your account has expired' in output.lower():
            return "Contraseña expirada"
        elif 'failed to authenticate using publickey authentication' in output.lower()\
            or 'message     : public key authentication failed' in output.lower():
            return "Error en llave SSH"
        elif 'failed to authenticate using the supplied password' in output.lower()\
            or 'nessus was unable to log into the following host for which credentials have been provided :' in output.lower()\
            or 'invalid credential' in output.lower():
            return 'Credenciales inválidas'
        elif 'admin$' in output.lower():
                return 'No acceso a RC ADMIN$'
    return ''

