def procesar_descripcion(descripcion):
    if pd.isna(descripcion):
        return '', '', '', '', '', '', ''
    
    descripcion_patron = re.compile(r'([0-9.]+)(-([0-9.]+))?:?\s*(.*?):\s*\[(PASSED|FAILED|NULL|ERROR|WARNING)\][\s\S]*?(?:See Also:.*?\n)?(.*?\n)?[\s\S]*?Policy Value:\n(?:CONFIG _CHECK_NOT|CONFIG_CHECK|SHOW_CONFIG_CHECK)?\s*([\s\S]*?)\s*(?:Actual Value:|Error:)\s*([\s\S]*)', re.DOTALL)
    match_descripcion = descripcion_patron.search(descripcion)
    if match_descripcion:
        item = match_descripcion.group(1).strip()
        subitem = match_descripcion.group(3).strip() if match_descripcion.group(3) else ''
        detalle = match_descripcion.group(4).strip()
        cumplimiento = match_descripcion.group(5).strip()
        valor_esperado = match_descripcion.group(7).strip()
        valor_hallado = match_descripcion.group(8).strip() 
        criticidad = match_descripcion.group(6).strip()
    else:
        item = ''
        subitem = ''
        detalle = ''
        cumplimiento = ''
        valor_esperado = ''
        valor_hallado = ''
        criticidad = ''
        
    return item, subitem, criticidad, cumplimiento, detalle, valor_esperado, valor_hallado

