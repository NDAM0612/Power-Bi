def definir_host(texto, nombre_inventario):
    if re.match(r'^\d{1,3}(\.\d{1,3}){3}$', texto):
        return str(nombre_inventario).upper() if nombre_inventario else 'unknow'
    else:
        return texto.upper()

def obtener_host(texto_host, entorno):
    nombre_inventario = "sin_nombre"
    # 1. Si es IP
    if re.match(r'^\d{1,3}(\.\d{1,3}){3}$', str(texto_host)):
        return str(nombre_inventario).upper() if nombre_inventario else 'UNKNOW'

    # 2. Si NO es IP → convertir a string
    host = str(texto_host).upper()

    # Si es ON PREMISE → quitar dominio
    if entorno == 'ON PREMISE':
        match = re.search(r'^(.*?)\.', host)
        if match:
            return match.group(1).upper()
        return host  # si no tiene dominio

    # Si NO es ON PREMISE → devolver tal cual
    return host

