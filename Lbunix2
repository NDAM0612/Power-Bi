    .groupby(['IP ADDRESS', 'CUMPLIMIENTO', 'HOST START'], observed=True)
    .size()
    .unstack('CUMPLIMIENTO', fill_value=0)
    .reindex(columns=['ERROR', 'FAILED', 'PASSED'], fill_value=0)
    .reset_index()
    .assign(**{'TOTAL DE ITEMS': lambda d: d[['ERROR', 'FAILED', 'PASSED']].sum(axis=1)})
)

resumen_final = (
    resumen
    .sort_values(by=['IP ADDRESS', 'TOTAL DE ITEMS', 'PASSED', 'HOST START'], ascending=[True, False, False, False])
    .drop_duplicates(subset=['IP ADDRESS'], keep='first')
    .reset_index(drop=True)
)

catalogo_general = df_archivos[['IP ADDRESS']].drop_duplicates()
pre_resumen_items = pd.merge(catalogo_general, resumen_final, on=['IP ADDRESS'], how='left')
cols = ['ERROR', 'FAILED', 'PASSED']
