# --- PROCESO INVENTARIO ---
ruta_inventario = Path(r"C:\Users\naarella\OneDrive - Banco Pichincha C.A\SISTEMAS OPERATIVOS\UNIX\INVENTARIO BP") / anio_actual
fecha_inventario = datetime.now().strftime("%m-%Y")
patron_inventario = re.compile(rf"^Inventario servidores BP .+{fecha_inventario}$", re.IGNORECASE)

