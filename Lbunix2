nombre_archivo_cloud = f'Hardening_Unix_Cloud_{fecha_actual}_nd.xlsx'
nombre_archivo_op = f'Hardening_Unix_OnPremise_{mes_actual}{anio_actual}_nd.xlsx'

carpeta = os.path.join('C:/Users/naarella/OneDrive - Banco Pichincha C.A/SISTEMAS OPERATIVOS/UNIX/TENABLE/', anio_actual, mes_actual.upper(), '22-09-2026')
ruta_resultado = 'C:/Users/naarella/OneDrive - Banco Pichincha C.A/SISTEMAS OPERATIVOS/UNIX/REPORTES/PRUEBA/2026'

