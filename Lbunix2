df_archivos.loc[mask_escaneado, 'SO'] = df_archivos.loc[mask_escaneado, 'OS'].apply(obtener_so)

# Vectorización de NOMBRE1 y NOMBRE2
df_archivos['NOMBRE1'] = obtener_host_vectorizado(df_archivos['HOST'], df_archivos['ENTORNO'])
