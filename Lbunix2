df_archivos = pd.concat(dfs, ignore_index=True)
df_archivos.columns = df_archivos.columns.str.upper()

# --- TRANSFORMACIONES VECTORIZADAS ---
df_archivos['OBSERVACION'] = df_archivos['DESCRIPTION'].apply(obtener_observacion)
df_archivos['JUSTIFICACION'] = df_archivos['PLUGIN OUTPUT'].apply(obtener_justificacion)

# Vectorización de TIPO ESCANEO
cond_escaneado = df_archivos['ITEM'] != ''
cond_no_escaneado = (df_archivos['ITEM'] == '') & (df_archivos['JUSTIFICACION'] != '')
df_archivos['TIPO ESCANEO'] = np.select([cond_escaneado, cond_no_escaneado], ['ESCANEADO', 'NO ESCANEADO'], default='')

# Vectorización SO
mask_escaneado = df_archivos['TIPO ESCANEO'] == 'ESCANEADO'
