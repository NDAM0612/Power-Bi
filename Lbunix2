items_cero = pre_resumen_items[pre_resumen_items['TOTAL DE ITEMS'] == 0].merge(catalogo_ip_cero, on='IP ADDRESS', how='left')

items_cero['TIPO ESCANEO'] = items_cero['TIPO ESCANEO'].fillna('NO ESCANEADO')
