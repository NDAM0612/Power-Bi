resumen_items_final = resumen_items[['NOMBRE1', 'NOMBRE2', 'IP ADDRESS', 'GRUPO SO', 'ENTORNO', 'ERROR', 'FAILED', 'PASSED', 'TOTAL DE ITEMS', 'ITEMS ESTÁNDAR', 'FECHA', 'TIPO ESCANEO']]

