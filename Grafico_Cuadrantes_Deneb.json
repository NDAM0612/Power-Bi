{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "width": "container",
  "height": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "title": {
    "text": "Ritmo de Ejecución y Riesgo de Concentración por Gerencia",
    "subtitle": "Posición = ritmo de ejecución en el año  ·  tamaño de burbuja = volumen de hitos gestionados",
    "anchor": "start",
    "fontSize": 15,
    "font": "Segoe UI",
    "color": "#0A185B",
    "subtitleFontSize": 11,
    "subtitleColor": "#5B6472",
    "offset": 12
