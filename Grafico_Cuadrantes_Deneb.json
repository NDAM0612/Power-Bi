      ],
      "mark": {
        "type": "rect",
        "color": "#F2A93B",
        "opacity": 0.09
      },
      "encoding": {
        "x": {
          "field": "x1tl",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              85
