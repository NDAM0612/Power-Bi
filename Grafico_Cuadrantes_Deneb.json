            "title": "Total Registros"
          },
          {
            "field": "Pct_Cierres_Q4",
            "type": "quantitative",
            "title": "% Cierres Q4",
            "format": ".1f"
          },
          {
            "field": "Gap_prom_pp",
            "type": "quantitative",
