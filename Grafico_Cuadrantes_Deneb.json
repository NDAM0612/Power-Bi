          "legend": null
        },
        "color": {
          "field": "Veredicto_Ritmo",
          "type": "nominal",
          "scale": {
            "domain": [
              "Ejecución constante",
              "Ritmo moderado",
              "Carga concentrada al cierre"
            ],
            "range": [
              "#3FA772",
              "#F2A93B",
              "#D6553F"
            ]
          },
