  "data": {
    "name": "dataset"
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "mean",
          "field": "Pct_Cierres_Q4",
          "as": "avgX"
        },
        {
          "op": "mean",
          "field": "Gap_prom_pp",
          "as": "avgY"
        }
      ]
    }
