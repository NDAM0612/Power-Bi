        "x": {
          "field": "Pct_Cierres_Q4",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              85
            ]
          },
          "axis": {
            "title": "% de Cierres Concentrados en Q4 (Oct-Dic)",
            "format": ".0f",
            "labelExpr": "datum.value + '%'",
            "titleColor": "#0A185B",
            "titleFontSize": 11,
            "labelColor": "#5B6472",
            "grid": false
          }
        },
        "y": {
          "field": "Gap_prom_pp",
          "type": "quantitative",
          "scale": {
            "domain": [
              -6,
              11
            ]
          },
          "axis": {
            "title": "Brecha de Avance vs. Plan (p.p.)",
            "titleColor": "#0A185B",
            "titleFontSize": 11,
            "labelColor": "#5B6472",
            "gridColor": "#E3E7EF"
          }
        },
        "size": {
          "field": "Total_Registros",
          "type": "quantitative",
          "scale": {
            "range": [
              200,
              3200
            ]
