              "op": "mean",
              "field": "avgX",
              "as": "avgX"
            },
            {
              "op": "mean",
              "field": "avgY",
              "as": "avgY"
            }
          ]
        },
        {
          "calculate": "0",
          "as": "x1tl"
        },
        {
          "calculate": "datum.avgX",
          "as": "x2tl"
        },
        {
          "calculate": "datum.avgY",
          "as": "y1tl"
        },
        {
          "calculate": "11",
