M_HTML_Dashboard_POA_1080p = 
VAR AvanceEsperadoVal = [M_Avance_Esperado]
VAR AvanceRealVal = [M_Avance_Real_Promedio]
VAR GapGlobalVal = [M_Gap_POA]

VAR AvanceEsperado = FORMAT(AvanceEsperadoVal, "0.0%")
VAR AvanceReal = FORMAT(AvanceRealVal, "0.0%")
VAR GapGlobal = FORMAT(GapGlobalVal, "+0.0%;-0.0%;0.0%")
VAR GerenciasCriticas = [M_Gerencias_Criticas_Count]
VAR FechaCorteTexto = FORMAT([M_Fecha_Corte], "dd \de mmmm, yyyy", "es-ES")

// 1. GENERADOR DINÁMICO DE PUNTOS SVG (SCATTER PLOT 1080p)
VAR PuntosScatterSVG = 
CONCATENATEX(
    VALUES('data_POA'[Gerencia Responsable]),
    VAR G_AvanceReal = [M_Avance_Real_Promedio]
    VAR G_AvanceEsp = [M_Avance_Esperado]
    VAR PosX = MIN(MAX(G_AvanceEsp * 100, 8), 92)
    VAR PosY = 100 - MIN(MAX(G_AvanceReal * 100, 8), 92)
    VAR Sigla = UPPER(LEFT('data_POA'[Gerencia Responsable], 3))
    VAR ColorBubble = 
        IF(G_AvanceReal >= G_AvanceEsp, "#10b981", IF(G_AvanceReal >= G_AvanceEsp - 0.10, "#f59e0b", "#f43f5e"))
    RETURN
    "<g class='bubble-group'>" &
        "<circle cx='" & FORMAT(PosX, "0.0") & "%' cy='" & FORMAT(PosY, "0.0") & "%' r='20' fill='" & ColorBubble & "' stroke='#ffffff' stroke-width='2.5'/>" &
        "<text x='" & FORMAT(PosX, "0.0") & "%' y='" & FORMAT(PosY + 0.8, "0.0") & "%' font-size='12' font-weight='800' fill='#ffffff' text-anchor='middle' dominant-baseline='middle'>" & Sigla & "</text>" &
    "</g>",
    ""
)

VAR LineaCorteX = FORMAT(MIN(MAX(AvanceEsperadoVal * 100, 8), 92), "0.0") & "%"
VAR LineaCorteY = FORMAT(100 - MIN(MAX(AvanceEsperadoVal * 100, 8), 92), "0.0") & "%"

// 2. GENERADOR DINÁMICO DE FILAS PARA TABLA EN 1080p
VAR FilasRankingHTML = 
CONCATENATEX(
    VALUES('data_POA'[Gerencia Responsable]),
    VAR AvanceGerencia = [M_Avance_Real_Promedio]
    VAR GapGerencia = AvanceGerencia - AvanceEsperadoVal
    VAR RetrasoGerencia = [M_Dias_Retraso_Acumulados]
    VAR ColorBarra = 
        SWITCH(
            TRUE(),
            GapGerencia >= 0, "#10b981",
            GapGerencia >= -0.10, "#f59e0b",
            "#f43f5e"
        )
    VAR ClassPill = 
        SWITCH(
            TRUE(),
            GapGerencia >= 0, "pill-green",
            GapGerencia >= -0.10, "pill-yellow",
            GapGerencia >= -0.20, "pill-orange",
            "pill-red"
        )
    VAR TextoEstado = 
        SWITCH(
            TRUE(),
            GapGerencia >= 0, "🟢 En Regla",
            GapGerencia >= -0.10, "🟡 Tolerancia",
            GapGerencia >= -0.20, "🟠 En Riesgo",
            "🔴 Crítico"
        )
    RETURN
    "<tr>" &
        "<td style='font-size:14px;'><b>" & 'data_POA'[Gerencia Responsable] & "</b></td>" &
        "<td><div class='progress-bar-bg'><div class='progress-bar-fill' style='width: " & FORMAT(AvanceGerencia, "0%") & "; background-color: " & ColorBarra & ";'></div></div> <span style='font-size:14px; font-weight:700; margin-left:8px;'>" & FORMAT(AvanceGerencia, "0.0%") & "</span></td>" &
        "<td style='font-weight:700; font-size:14px; color:" & ColorBarra & ";'>" & FORMAT(GapGerencia, "+0.0%;-0.0%;0.0%") & "</td>" &
        "<td style='font-size:14px;'>" & COALESCE(RetrasoGerencia, 0) & " días</td>" &
        "<td><span class='status-pill " & ClassPill & "'>" & TextoEstado & "</span></td>" &
    "</tr>",
    ""
)

RETURN
"
<style>
