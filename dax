    /* SCATTER CANVAS 1080p */
    .scatter-svg-container {
        width: 100%;
        height: 620px;
        background-color: #fafafa;
        border: 1px dashed #cbd5e1;
        border-radius: 8px;
        position: relative;
    }
    .svg-canvas { width: 100%; height: 100%; }

    /* TABLE 1080p */
    .ranking-table { width: 100%; border-collapse: collapse; }
    .ranking-table th { background-color: #f1f5f9; color: #475569; font-weight: 700; text-align: left; padding: 12px 16px; font-size: 13px; }
    .ranking-table td { padding: 14px 16px; border-bottom: 1px solid #f1f5f9; vertical-align: middle; }

    .progress-bar-bg { background-color: #e2e8f0; border-radius: 6px; height: 12px; width: 140px; display: inline-block; vertical-align: middle; overflow: hidden; }
    .progress-bar-fill { height: 100%; border-radius: 6px; }

    .status-pill { padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 700; display: inline-block; text-align: center; }
    .pill-green { background-color: #d1fae5; color: #065f46; }
    .pill-yellow { background-color: #fef3c7; color: #92400e; }
    .pill-orange { background-color: #ffedd5; color: #9a3412; }
    .pill-red { background-color: #ffe4e6; color: #9f1239; }

    .insight-box {
        background-color: #eff6ff;
        border-left: 6px solid #3b82f6;
        padding: 18px 24px;
        border-radius: 0 8px 8px 0;
        font-size: 14px;
        color: #1e40af;
        line-height: 1.6;
    }
</style>

<div class='poa-dashboard-1080p'>
    <!-- APP HEADER -->
    <div class='app-header'>
        <div>
            <h1 class='app-title'>EVALUACIÓN DEL PLAN OPERATIVO ANUAL (POA)</h1>
            <div class='app-subtitle'>Panel de Monitoreo Ejecutivo Full HD (1920x1080)</div>
        </div>
        <div>
            <span class='badge-date'>Corte: " & FechaCorteTexto & "</span>
        </div>
    </div>

    <!-- KPI CARDS REGION -->
    <div class='kpi-row'>
        <div class='kpi-card'>
            <div class='kpi-label'>% Avance Esperado (Hoy)</div>
            <div class='kpi-value text-amber'>" & AvanceEsperado & "</div>
            <div class='kpi-subtext'>Programado Teórico del Año</div>
        </div>
        <div class='kpi-card'>
            <div class='kpi-label'>% Avance Real Promedio</div>
            <div class='kpi-value text-rose'>" & AvanceReal & "</div>
            <div class='kpi-subtext'>Promedio Registrado en POA</div>
        </div>
        <div class='kpi-card'>
            <div class='kpi-label'>Brecha Global (Gap)</div>
            <div class='kpi-value text-rose'>" & GapGlobal & "</div>
            <div class='kpi-subtext'>Desviación Consolidada</div>
        </div>
        <div class='kpi-card'>
            <div class='kpi-label'>Gerencias Críticas</div>
            <div class='kpi-value text-rose'>" & GerenciasCriticas & "</div>
            <div class='kpi-subtext'>Desviación Crítica (> 20%)</div>
        </div>
    </div>

    <!-- MAIN BODY 1080p -->
    <div class='dashboard-grid'>
        <!-- PANEL IZQUIERDO: CUADRANTE SVG AMPLIADO -->
        <div class='widget-panel'>
            <div class='widget-header'>
                <span class='widget-title'>1. Matriz de Cuadrante Ejecutiva (1080p Canvas)</span>
                <span class='widget-tag'>X: Avance Esperado | Y: Avance Real</span>
            </div>
            <div class='scatter-svg-container'>
                <svg class='svg-canvas'>
                    <line x1='" & LineaCorteX & "' y1='0' x2='" & LineaCorteX & "' y2='100%' stroke='#94a3b8' stroke-dasharray='6' stroke-width='2'/>
                    <line x1='0' y1='" & LineaCorteY & "' x2='100%' y2='" & LineaCorteY & "' stroke='#94a3b8' stroke-dasharray='6' stroke-width='2'/>
                    
                    <text x='96%' y='5%' font-size='12' font-weight='bold' fill='#065f46' text-anchor='end'>C1: ALTO DESEMPEÑO</text>
                    <text x='4%' y='96%' font-size='12' font-weight='bold' fill='#9f1239' text-anchor='start'>C3: ALERTA CRÍTICA</text>

                    " & PuntosScatterSVG & "
                </svg>
            </div>
        </div>

        <!-- PANEL DERECHO: RANKING + INSIGHTS -->
        <div style='display: flex; flex-direction: column; justify-content: space-between;'>
            <div class='widget-panel' style='height: 480px;'>
                <div class='widget-header'>
                    <span class='widget-title'>2. Ranking por Gerencia Responsable</span>
                    <span class='widget-tag'>Vista Integrada</span>
                </div>
                <table class='ranking-table'>
                    <thead>
                        <tr>
                            <th>Gerencia</th>
                            <th>Avance Real</th>
                            <th>Gap</th>
                            <th>Retraso</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        " & FilasRankingHTML & "
                    </tbody>
                </table>
            </div>

            <div class='widget-panel' style='height: 245px;'>
                <div class='widget-header'>
                    <span class='widget-title'>3. Diagnóstico Ejecutivo Automático</span>
                    <span class='widget-tag'>Smart Narrative DAX</span>
                </div>
                <div class='insight-box'>
                    <strong>Resumen Estratégico al Corte (" & FechaCorteTexto & "):</strong><br>
                    El avance promedio de las iniciativas es del <strong>" & AvanceReal & "</strong> frente a una meta teórica del <strong>" & AvanceEsperado & "</strong>, dejando una brecha operativa global de <strong>" & GapGlobal & "</strong>.<br>
                    Actualmente se registran <strong>" & GerenciasCriticas & " gerencias</strong> en estado crítico que requieren revisión inmediata de entregables.
                </div>
            </div>
        </div>
    </div>
