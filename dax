    }
    .kpi-label { font-size: 12px; text-transform: uppercase; color: #64748b; font-weight: 700; letter-spacing: 0.05em; }
    .kpi-value { font-size: 36px; font-weight: 800; line-height: 1.1; margin-top: 4px; }
    .kpi-subtext { font-size: 12px; color: #64748b; margin-top: 4px; }

    .text-amber { color: #f59e0b; }
    .text-rose { color: #f43f5e; }

    /* MAIN GRID REGION - 760px HEIGHT */
    .dashboard-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
