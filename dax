<style>
    /* Contenedor principal responsive */
    .hero-container {
        position: relative;
        width: 100%;
        height: 100vh;
        min-height: 200px;
        background-color: #071536; /* Color de fondo superior */
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: center;
        overflow: hidden;
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    /* Ajuste del vector SVG de las nubes */
    .clouds-svg {
        width: 100%;
        height: auto;
        display: block;
        vertical-align: bottom;
    }

    /* Envoltorio del botón de scroll */
    .scroll-indicator-wrap {
        position: absolute;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 20;
    }

    /* Estilo del botón circular de scroll */
    .scroll-button {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 44px;
        height: 44px;
        background-color: #FFFFFF;
        border-radius: 50%;
        box-shadow: 0 4px 12px rgba(7, 21, 54, 0.15);
        text-decoration: none;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        animation: bounce 2s infinite;
    }

    .scroll-button:hover {
        transform: scale(1.1);
        box-shadow: 0 6px 16px rgba(7, 21, 54, 0.25);
    }

    .scroll-button svg {
        width: 24px;
        height: 24px;
        stroke: #071536;
        stroke-width: 2.5;
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /* Animación suave de rebote */
    @keyframes bounce {
        0%, 20%, 50%, 80%, 100% {
            transform: translateY(0);
        }
        40% {
            transform: translateY(-8px);
        }
        60% {
            transform: translateY(-4px);
        }
    }
</style>

